# ─────────────────────────────────────────────────────────────
# Football App — environment configuration
#
# Copy this file to `.env.local` and fill in your key:
#   cp .env.example .env.local
#
# All content is pulled live from API-Football (RapidAPI). Without a key the
# data views show a "connect a key" placeholder — no data is bundled.
# ─────────────────────────────────────────────────────────────

# Your API-Football key from RapidAPI:
#   https://rapidapi.com/api-sports/api/api-football
# Note: Vite exposes any VITE_* var to the browser bundle. This is
# fine for local/personal use; for production, proxy through a
# backend so the key is never shipped to clients.
VITE_API_FOOTBALL_KEY=

# Which league / team / season the feeds are anchored to.
# Defaults below target the Premier League and Arsenal, 2025/26.
VITE_API_FOOTBALL_LEAGUE=39
VITE_API_FOOTBALL_TEAM=42
VITE_API_FOOTBALL_SEASON=2025

# How long (minutes) cached API responses stay fresh. Higher = fewer
# requests against the free-tier quota. Default 15.
VITE_API_FOOTBALL_CACHE_MINUTES=15
